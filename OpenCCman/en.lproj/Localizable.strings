// MARK: - Help
"help_intro" = "Open Chinese Convert (OpenCC, 開放中文轉換) is an opensource project for conversions between Traditional Chinese, Simplified Chinese and Japanese Kanji (Shinjitai). It supports character-level and phrase-level conversion, character variant conversion and regional idioms among Mainland China, Taiwan and Hong Kong. This is not translation tool between Mandarin and Cantonese, etc.";

"help_features_title" = "Features";
"help_features_content" = "Strictly differentiate between 「one simplified to many traditionals」 and 「one simplified to many variants」.\nCompletely compatible with different variants and can realize dynamic substitution.\nStrictly scrutinize one-simplified-to-multiple-traditional entries, and the principle is 「if it can be divided, then it will be divided」.\nSupport Mainland China, Taiwan, Hong Kong, different variants and regional customary word conversion, such as 「裏」「裡」、「鼠標」「滑鼠」.";

"help_global_service_title" = "Global Service (macOS)";
"help_global_service_intro" = "OpenCCman provides multiple ways to convert Chinese text from any application:";

"help_method1_title" = "Method 1: Global Keyboard Shortcuts (Recommended)";
"help_method1_content" = "OpenCCman provides two global keyboard shortcuts:\n\n• Convert Selected Text (default: ⌘⌥T) - Automatically converts and replaces selected text in editable fields\n• Open Selected Text (default: ⌘⌥R) - Opens selected text in OpenCCman for manual conversion\n\n1. Go to Settings > Global Shortcut to configure your shortcuts\n2. Select any Chinese text in any application\n3. Press your configured shortcut\n4. Convert shortcut: Text will be automatically converted and replaced in-place (works in text editors, browsers, etc.)\n5. Open shortcut: OpenCCman will open with the text ready for conversion";

"help_method2_title" = "Method 2: Right-click Services";
"help_method2_content" = "OpenCCman provides two right-click services:\n\n• \"Convert Chinese Text with OpenCCman\" - Automatically converts and replaces the selected text\n• \"Open Selected Text in OpenCCman\" - Opens the app with the selected text for manual conversion\n\n1. Select text in any app (Safari, TextEdit, etc.)\n2. Right-click and choose your preferred service from the Services menu\n3. For convert service: text is automatically converted and replaced\n4. For open service: OpenCCman opens with the text ready for conversion";

"help_service_tip" = "You can also assign keyboard shortcuts to these services in System Settings > Keyboard > Keyboard Shortcuts > Services > Text for even faster access.";

"help_service_details_title" = "Service Details";
"help_service_details_content" = "• Convert Service: Best for quick, automatic conversion when you're confident with current settings\n• Open Service: Perfect when you want to review the text, adjust conversion settings, or keep both original and converted text visible\n• Both services work in any macOS application that supports text selection";

"help_conclusion" = "The keyboard shortcut method is fastest for immediate conversion. Use the \"Open Selected Text\" service when you want to review or adjust settings before converting.";

